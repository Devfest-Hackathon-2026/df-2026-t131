{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machi-talk.example/schema/zone_entry.schema.json",
  "title": "カメラで調べない区域の1件1ファイル（cloud/data/manual/zones/<ID>.json）",
  "description": "タイルの応答の形（zone.schema.json）に、版・メモ・出典を足したもの。build_sqlite.py が schema_version・note・source を外してタイルに入れる",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "lat", "lon", "radius_m", "reason", "note", "source"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "id": { "$ref": "common.schema.json#/$defs/zone_id" },
    "name": { "type": "string", "minLength": 1 },
    "lat": { "$ref": "common.schema.json#/$defs/lat" },
    "lon": { "$ref": "common.schema.json#/$defs/lon" },
    "radius_m": { "type": "number", "minimum": 5, "maximum": 300 },
    "reason": { "enum": ["demo", "facility_rule", "indoor"] },
    "note": { "type": "string", "description": "なぜここを区域にしたか（人が読むメモ。タイルには入れない）" },
    "source": { "type": "string", "minLength": 1, "description": "位置の出典" }
  }
}
