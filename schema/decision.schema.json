{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambient-narrative.example/schema/decision.schema.json",
  "title": "判断ログ1行（JSON Lines）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "t_ms",
    "kind",
    "reason",
    "target_id",
    "text",
    "priority"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "t_ms": {
      "$ref": "common.schema.json#/$defs/t_ms"
    },
    "kind": {
      "enum": [
        "speak",
        "skip",
        "search",
        "search_skip",
        "answer",
        "fetch"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "^(speak|skip|search|search_skip|answer|fetch):[a-z0-9_]+$",
      "description": "reason_codes.json にあるものだけ"
    },
    "target_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 6
    },
    "sources": {
      "type": "array",
      "description": "任意。kind が answer のときだけ。B の答えの裏付けに使った出典（visual_search の応答の sources をそのまま入れる）。判断画面で「なぜその名前と言ったか」を示すため",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "uri"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "place_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
