{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machi-talk.example/schema/common.schema.json",
  "title": "共通の型",
  "$defs": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "t_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC の UNIX ミリ秒"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "deg": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360,
      "description": "真北0°・時計回り"
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "z",
        "x",
        "y"
      ],
      "properties": {
        "z": {
          "const": 16
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "landmark_id": {
      "type": "string",
      "pattern": "^lm_\\d{4}$"
    },
    "zone_id": {
      "type": "string",
      "pattern": "^zn_\\d{4}$"
    },
    "area_code": {
      "type": "string",
      "pattern": "^\\d{7}$",
      "description": "気象庁の「気象警報・注意報」の区域（市町村等）のコード7桁。例：富山市は 1620100"
    },
    "stop_id": {
      "type": "string",
      "pattern": "^st_\\d{4}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ev_\\d{4}$"
    },
    "crossing_id": {
      "type": "string",
      "pattern": "^cr_\\d{4,6}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "license"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "landmark_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "parts",
        "margin_m"
      ],
      "description": "ランドマークの実際の形（11/7 追加。OpenStreetMap の輪郭・線）。形から margin_m 以内（polygon は中も）を範囲とし、radius_m の円の代わりに使う。形を知らない古い engine のため radius_m も残す",
      "properties": {
        "type": {
          "enum": [
            "polygon",
            "line"
          ],
          "description": "polygon＝輪郭（公園・建物・橋）、line＝線（通り・川）"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "description": "形の部品（建物が2棟なら2つ）。各部品は [緯度, 経度] の並び。polygon は閉じなくてよい（最後と最初を結ぶ）",
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/lat"
                },
                {
                  "$ref": "#/$defs/lon"
                }
              ]
            }
          }
        },
        "margin_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "形からこの距離までを範囲に入れる（建物の外の歩道を歩いても入るように）。公園は 0（輪郭の中だけ）"
        },
        "source": {
          "type": "string",
          "description": "形の出どころ（OpenStreetMap の way の番号など）"
        }
      }
    }
  }
}
