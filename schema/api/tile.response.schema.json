{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambient-narrative.example/schema/api/tile.response.schema.json",
  "title": "GET /v1/tiles/16/{x}/{y} の応答",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tile",
    "landmarks",
    "stops",
    "crossings",
    "events"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../common.schema.json#/$defs/schema_version"
    },
    "tile": {
      "$ref": "../common.schema.json#/$defs/tile"
    },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "name_kana",
          "lat",
          "lon",
          "kind",
          "script_short",
          "script_long",
          "visual_hint"
        ],
        "properties": {
          "id": {
            "$ref": "../common.schema.json#/$defs/landmark_id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "name_kana": {
            "type": "string",
            "pattern": "^[ぁ-ゖー・\\s]+$",
            "description": "ひらがなの読み"
          },
          "lat": {
            "$ref": "../common.schema.json#/$defs/lat"
          },
          "lon": {
            "$ref": "../common.schema.json#/$defs/lon"
          },
          "kind": {
            "enum": [
              "area",
              "monument",
              "building",
              "street",
              "place_name",
              "shrine_temple",
              "nature",
              "other"
            ],
            "description": "area は公園・境内など範囲を持つ場所。中に入ったら定型文を一度話し、中の名前付きの対象は B が特定する"
          },
          "radius_m": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "ジオフェンス半径。area のときはエリアの範囲（必須）。null なら定数の既定値"
          },
          "shape": {
            "$ref": "../common.schema.json#/$defs/landmark_shape",
            "description": "実際の形（任意。11/7 追加）。API は TILE_SHAPES=on のときだけ付ける（形を知らない古い engine はタイルを読めなくなるため）"
          },
          "script_short": {
            "type": "string",
            "maxLength": 80,
            "description": "目安60字以内"
          },
          "script_long": {
            "type": "string",
            "maxLength": 200,
            "description": "目安150字以内"
          },
          "visual_hint": {
            "type": "string",
            "description": "B の照合用の見た目の説明。11/8 までは空でよい"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "../common.schema.json#/$defs/source"
            }
          },
          "google_place_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "任意。Google マップの場所 ID（グラウンディングや判断画面の地図との紐づけ用）"
          },
          "name_hints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "description": "area だけ。エリア内の名前付きの対象の名前だけの一覧。**今は使わない方針**。デモ撮影で B の特定の失敗が続いたときの予備（CLAUDE.md 6章）"
          }
        },
        "description": "landmark から status を除いたもの。reviewed のものだけが返る",
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "area"
                }
              }
            },
            "then": {
              "properties": {
                "radius_m": {
                  "type": "number"
                }
              }
            }
          }
        ]
      }
    },
    "stops": {
      "type": "array",
      "items": {
        "$ref": "../stop.schema.json"
      }
    },
    "crossings": {
      "type": "array",
      "description": "OSM の横断歩道・信号",
      "items": {
        "$ref": "../crossing.schema.json"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "../event.schema.json"
      }
    },
    "towns": {
      "type": "array",
      "description": "このタイルの中に代表点がある町丁目（国土交通省 位置参照情報を加工）。位置から町丁目を引くときは、持っているタイルの町丁目のうち、いちばん近い代表点にする。800m より遠ければ「わからない」（cloud/data/scripts/town_lookup.py と同じ決め方）。11/6 夜に追加。API は必ず付けるが、端末に残っている古いタイルに無くても読めるよう required にはしない",
      "items": {
        "$ref": "../town.schema.json"
      }
    },
    "zones": {
      "type": "array",
      "description": "カメラで調べない区域。円（中心＋radius_m）に出る判定の幅15mを足した範囲がかかるタイルすべてに入る（エリアと同じ入れ方。engine は ID で重複を除く）。11/7 に追加。API は TILE_ZONES=on のとき、区域のあるタイルにだけ付ける（無いタイルにはキーごと付けない）。古いタイルに無くても読めるよう required にはしない",
      "items": {
        "$ref": "../zone.schema.json"
      }
    }
  }
}
