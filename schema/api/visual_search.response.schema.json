{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machi-talk.example/schema/api/visual_search.response.schema.json",
  "title": "POST /v1/visual-search の応答",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "search_id",
    "result",
    "landmark_id",
    "object_name",
    "description",
    "confidence",
    "sources",
    "named",
    "part"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../common.schema.json#/$defs/schema_version"
    },
    "search_id": {
      "type": "string"
    },
    "result": {
      "enum": [
        "matched",
        "unlisted",
        "unknown"
      ]
    },
    "landmark_id": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/landmark_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "matched のときだけ"
    },
    "object_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "unlisted のときだけ。名前が分かれば固有名（例：○○橋）、分からなければ一般名（例：木造の蔵）"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120,
      "description": "unlisted のとき、または matched で part が whole 以外（登録したランドマークの特徴）のとき。目安100字以内（約15秒）、数字・年号なし。特徴の説明は写真に見えていること（形・色・素材・飾り）だけ"
    },
    "part": {
      "enum": [
        "whole",
        "window",
        "entrance",
        "roof",
        "wall",
        "pillar",
        "sign",
        "statue",
        "railing",
        "planting",
        "waterside",
        "other",
        null
      ],
      "description": "中央に写っているのがどの部分か（docs/design.md 6章「B の仕様」）。whole＝そのもの全体、ほかは特定の部分（window 窓／entrance 入口・門／roof 屋根／wall 壁・外壁／pillar 柱／sign 看板・文字／statue 像・彫刻／railing 欄干・手すり／planting 植え込み・木／waterside 水辺・川・運河／other その他）。unknown のときだけ null。重複判定は（場所, part）で行う"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "named": {
      "type": "boolean",
      "description": "object_name が固有名か。重複判定はエリアごとに object_name で行う"
    },
    "sources": {
      "type": "array",
      "description": "裏付けに使った出典（Google マップでのグラウンディングなど）。無ければ空",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "uri"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "place_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "matched"
          }
        }
      },
      "then": {
        "properties": {
          "landmark_id": {
            "type": "string"
          },
          "object_name": {
            "type": "null"
          },
          "part": {
            "enum": [
              "whole",
              "window",
              "entrance",
              "roof",
              "wall",
              "pillar",
              "sign",
              "statue",
              "railing",
              "planting",
              "waterside",
              "other"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "unlisted"
          }
        }
      },
      "then": {
        "properties": {
          "landmark_id": {
            "type": "null"
          },
          "object_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "part": {
            "enum": [
              "whole",
              "window",
              "entrance",
              "roof",
              "wall",
              "pillar",
              "sign",
              "statue",
              "railing",
              "planting",
              "waterside",
              "other"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "landmark_id": {
            "type": "null"
          },
          "object_name": {
            "type": "null"
          },
          "description": {
            "type": "null"
          },
          "part": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "matched"
          },
          "part": {
            "const": "whole"
          }
        },
        "required": [
          "result",
          "part"
        ]
      },
      "then": {
        "properties": {
          "description": {
            "type": "null"
          }
        }
      },
      "$comment": "登録したランドマーク全体：A の確認済みの原稿を読むので説明は返さない"
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "matched"
          },
          "part": {
            "enum": [
              "window",
              "entrance",
              "roof",
              "wall",
              "pillar",
              "sign",
              "statue",
              "railing",
              "planting",
              "waterside",
              "other"
            ]
          }
        },
        "required": [
          "result",
          "part"
        ]
      },
      "then": {
        "properties": {
          "description": {
            "type": "string"
          }
        }
      },
      "$comment": "登録したランドマークの特徴：説明を返す"
    }
  ]
}
