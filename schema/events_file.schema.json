{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machi-talk.example/schema/events_file.schema.json",
  "title": "cloud/data/manual/events.json 全体（イベントのモック）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "events"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "event.schema.json"
      }
    }
  }
}
