{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambient-narrative.example/schema/landmark.schema.json",
  "title": "ランドマーク1件（cloud/data/manual/landmarks.json の各要素）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "name_kana",
    "lat",
    "lon",
    "kind",
    "script_short",
    "script_long",
    "visual_hint",
    "sources",
    "status"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version",
      "description": "1件1ファイル（cloud/data/manual/landmarks/<ID>.json）のときは必須（landmark_entry.schema.json）"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/landmark_id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "name_kana": {
      "type": "string",
      "pattern": "^[ぁ-ゖー・\\s]+$",
      "description": "ひらがなの読み"
    },
    "lat": {
      "$ref": "common.schema.json#/$defs/lat"
    },
    "lon": {
      "$ref": "common.schema.json#/$defs/lon"
    },
    "kind": {
      "enum": [
        "area",
        "monument",
        "building",
        "street",
        "place_name",
        "shrine_temple",
        "nature",
        "other"
      ],
      "description": "area は公園・境内など範囲を持つ場所。中に入ったら定型文を一度話し、中の名前付きの対象は B が特定する"
    },
    "radius_m": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "description": "ジオフェンス半径。area のときはエリアの範囲（必須）。null なら定数の既定値"
    },
    "script_short": {
      "type": "string",
      "maxLength": 80,
      "description": "目安60字以内"
    },
    "script_long": {
      "type": "string",
      "maxLength": 200,
      "description": "目安150字以内"
    },
    "visual_hint": {
      "type": "string",
      "description": "B の照合用の見た目の説明。11/8 までは空でよい"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/source"
      }
    },
    "status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "google_place_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "任意。Google マップの場所 ID（グラウンディングや判断画面の地図との紐づけ用）"
    },
    "name_hints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "description": "area だけ。エリア内の名前付きの対象の名前だけの一覧。**今は使わない方針**。デモ撮影で B の特定の失敗が続いたときの予備（CLAUDE.md 6章）"
    }
  },
  "description": "draft の間は script_short・script_long・visual_hint を空文字にしてよい。reviewed では原稿2つが必須",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "reviewed"
          }
        }
      },
      "then": {
        "properties": {
          "script_short": {
            "minLength": 1
          },
          "script_long": {
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "area"
          }
        }
      },
      "then": {
        "properties": {
          "radius_m": {
            "type": "number"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "not": {
              "const": "area"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "name_hints"
          ]
        }
      }
    }
  ]
}
