{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambient-narrative.example/schema/zone.schema.json",
  "title": "カメラで調べない区域（タイルの応答の zones の1件）",
  "description": "この円の中では B（画像での案内）を撮らない。A は続ける。入るのは中心から radius_m 以内、出るのは radius_m＋15m より外（engine の定数 zoneExitMarginM）。11/7 に追加",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "lat", "lon", "radius_m", "reason"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/zone_id" },
    "name": { "type": "string", "minLength": 1, "description": "画面・判断ログに出す名前（例：あいの島・バードサンクチュアリ）" },
    "lat": { "$ref": "common.schema.json#/$defs/lat" },
    "lon": { "$ref": "common.schema.json#/$defs/lon" },
    "radius_m": { "type": "number", "minimum": 5, "maximum": 300, "description": "区域の半径（m）" },
    "reason": {
      "enum": ["demo", "facility_rule", "indoor"],
      "description": "demo：デモのため仮に指定／facility_rule：施設が撮影を禁止／indoor：建物の中"
    }
  }
}
