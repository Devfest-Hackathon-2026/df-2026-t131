{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machi-talk.example/schema/towns_file.schema.json",
  "title": "cloud/data/address/towns.json 全体（build_address.py の出力）",
  "description": "国土交通省 位置参照情報（大字・町丁目レベル）から、横断歩道と同じ範囲の町丁目の代表点だけを取り出したもの。今はタイルの応答には入れない（schema/api/tile.response.schema.json は変えていない）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "bbox", "towns"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "source": {
      "$ref": "common.schema.json#/$defs/source",
      "description": "位置参照情報の出典（国土交通省）"
    },
    "bbox": {
      "type": "array",
      "description": "取り出した範囲 [南, 西, 北, 東]",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "towns": {
      "type": "array",
      "items": { "$ref": "town.schema.json" }
    }
  }
}
